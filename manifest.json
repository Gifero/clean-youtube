{
  "manifest_version": 3,
  "name": "Clean YouTube: Hide Shorts & Members",
  "short_name": "Clean YouTube",
  "version": "1.1.1",
  "description": "Oculta los YouTube Shorts y los vídeos exclusivos para miembros. Redirige los enlaces de Shorts al reproductor normal.",
  "author": "Gifero",
  "homepage_url": "https://github.com/Gifero/clean-youtube",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png"
    },
    "default_title": "Clean YouTube",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clean-youtube@gifero.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "css": [
        "hide.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}